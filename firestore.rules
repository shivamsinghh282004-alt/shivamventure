rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'photoURL',
        'businessName', 'city', 'taxRegime', 'gstRegistered',
        'annualTarget', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'photoURL',
        'businessName', 'city', 'taxRegime', 'gstRegistered',
        'annualTarget', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.photoURL is string && data.photoURL.size() <= 500
      && data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 120
      && data.city is string && data.city.size() <= 80
      && data.taxRegime in ['44ada', 'new_regime']
      && data.gstRegistered is bool
      && data.annualTarget is number && data.annualTarget >= 0 && data.annualTarget <= 1000000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidIncomeEntry(data) {
      return data.keys().hasAll([
        'ownerId', 'clientName', 'platform', 'category',
        'grossAmount', 'tdsAmount', 'gstAmount', 'status',
        'receivedDate', 'notes', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'clientName', 'platform', 'category',
        'grossAmount', 'tdsAmount', 'gstAmount', 'status',
        'receivedDate', 'notes', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.ownerId)
      && data.ownerId == request.auth.uid
      && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
      && data.platform in ['Direct UPI / Bank', 'Upwork', 'Fiverr', 'Razorpay', 'Stripe', 'Other']
      && data.category in ['Design', 'Development', 'Content & Video', 'Tutoring', 'Consulting', 'Other']
      && data.grossAmount is number && data.grossAmount > 0 && data.grossAmount <= 100000000
      && data.tdsAmount is number && data.tdsAmount >= 0 && data.tdsAmount <= data.grossAmount
      && data.gstAmount is number && data.gstAmount >= 0 && data.gstAmount <= data.grossAmount
      && data.status in ['received', 'pending']
      && isValidDateString(data.receivedDate)
      && data.notes is string && data.notes.size() <= 400
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidWorkflowTask(data) {
      return data.keys().hasAll([
        'ownerId', 'title', 'clientName', 'category',
        'priority', 'status', 'dueDate', 'amountLinked',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'title', 'clientName', 'category',
        'priority', 'status', 'dueDate', 'amountLinked',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.ownerId)
      && data.ownerId == request.auth.uid
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
      && data.clientName is string && data.clientName.size() <= 120
      && data.category in ['Tax & GST', 'Client Follow-up', 'Deliverable', 'Invoicing']
      && data.priority in ['high', 'medium', 'low']
      && data.status in ['todo', 'in_progress', 'completed']
      && isValidDateString(data.dueDate)
      && data.amountLinked is number && data.amountLinked >= 0 && data.amountLinked <= 100000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidClientRecord(data) {
      return data.keys().hasAll([
        'ownerId', 'name', 'platform', 'billingType',
        'retainerAmount', 'taxScope', 'contactNote',
        'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId', 'name', 'platform', 'billingType',
        'retainerAmount', 'taxScope', 'contactNote',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.ownerId)
      && data.ownerId == request.auth.uid
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
      && data.platform in ['Direct UPI / Bank', 'Upwork', 'Fiverr', 'Razorpay', 'Stripe', 'Other']
      && data.billingType in ['Retainer', 'Milestone', 'Hourly']
      && data.retainerAmount is number && data.retainerAmount >= 0 && data.retainerAmount <= 100000000
      && data.taxScope in ['domestic_tds', 'domestic_no_tds', 'export_lut']
      && data.contactNote is string && data.contactNote.size() <= 240
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // /users/{userId} - Strictly isolated to the owner (no list, no delete)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'businessName', 'city', 'taxRegime', 'gstRegistered', 'annualTarget', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'email', 'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // /incomes/{incomeId} - Freelance income ledger
    match /incomes/{incomeId} {
      allow get: if isValidId(incomeId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(incomeId)
        && isSignedIn()
        && isValidIncomeEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(incomeId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid
        && isValidIncomeEntry(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'clientName', 'platform', 'category', 'grossAmount',
            'tdsAmount', 'gstAmount', 'status', 'receivedDate', 'notes', 'updatedAt'
          ])
        );
      allow delete: if isValidId(incomeId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // /workflows/{workflowId} - Automated workflow & tax deadline tasks
    match /workflows/{workflowId} {
      allow get: if isValidId(workflowId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(workflowId)
        && isSignedIn()
        && isValidWorkflowTask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(workflowId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid
        && isValidWorkflowTask(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'clientName', 'category', 'priority', 'status',
            'dueDate', 'amountLinked', 'updatedAt'
          ])
        );
      allow delete: if isValidId(workflowId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // /clients/{clientId} - Client directory
    match /clients/{clientId} {
      allow get: if isValidId(clientId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isValidId(clientId)
        && isSignedIn()
        && isValidClientRecord(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(clientId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid
        && isValidClientRecord(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'platform', 'billingType', 'retainerAmount',
            'taxScope', 'contactNote', 'updatedAt'
          ])
        );
      allow delete: if isValidId(clientId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
